# Copy this file to .env and fill in your values

# Database Configuration
# Option 1: Use DATABASE_URL (Supabase, Railway, Render - recommended for production)
DATABASE_URL=postgresql://postgres.xxxxx:yourpassword@db.xxxxx.supabase.co:5432/postgres

# Option 2: Use individual values (for local development with Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=ihb_transport

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password

# JWT Secret (generate a strong random string)
JWT_SECRET=your-jwt-secret-key-here

# Server Configuration
PORT=8080
GIN_MODE=release
