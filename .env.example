# Copy this file to .env and fill in your values

# Database Configuration
# Option 1: Use DATABASE_URL (Supabase, Railway, Render - recommended for production)
DATABASE_URL=postgresql://postgres.xxxxx:yourpassword@db.xxxxx.supabase.co:5432/postgres

# Option 2: Use individual values (for local development with Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=ihb_transport

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password

# JWT Secret (generate a strong random string)
JWT_SECRET=your-jwt-secret-key-here

# Server Configuration
PORT=8080
GIN_MODE=release

# SMTP Email Configuration (Optional - if not set, emails will be logged to console)
# For Gmail: smtp.gmail.com:587 (requires App Password, not regular password)
# For SendGrid: smtp.sendgrid.net:587
# For SMTP2GO: mail.smtp2go.com:2525
# For Mailgun: smtp.mailgun.org:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@ihbtransport.com
SMTP_FROM_NAME=IHB Transport

# Resend (HTTP API) - optional. If `RESEND_API_KEY` is set, the service will prefer
# Resend for sending emails (avoids SMTP egress issues on some hosts like Render).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# FRONTEND_BASE_URL (optional) - when set, email links (Accept/Decline) will point
# to your frontend SPA instead of the backend API. Example: https://www.ihbtransportaps.dk
FRONTEND_BASE_URL=https://www.ihbtransportaps.dk
